# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/travel"
# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=""
# Claude API key for the booking assistant (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# --- First admin (created on deploy if there is no admin yet; 12+ char password) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Optional ---
# Where uploaded documents and package photos are stored. On Railway, point this at the volume: /data/uploads
UPLOAD_DIR="./uploads"
# Shown on the login page for people who forgot their password
SUPPORT_EMAIL=""
